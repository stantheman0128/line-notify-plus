# Release signing config for LINE Notify+
#
# 1. Generate the keystore (see README / Claude instructions for the keytool command)
# 2. Copy this file to "keystore.properties" (same folder)
# 3. Fill in the real values below
# 4. keystore.properties and the .jks file are git-ignored — never commit them
#
# storeFile path is relative to the project root.

storeFile=keystore/line-notify-release.jks
storePassword=YOUR_KEYSTORE_PASSWORD
keyAlias=line-notify
keyPassword=YOUR_KEY_PASSWORD
